# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Obsidian
.obsidian/
.trash/

# Local agent state (not part of the project knowledge)
.project/state/
.project/cache/
.claude/settings.local.json

# Working notes from the design process
docs/superpowers/

# Exports and builds
# Anchored to the repository root: `export/` unanchored would also swallow
# .project/templates/export/, which is tracked and ships a README.
/export/
build/
*.docx
*.epub
*.pdf
# The one binary a book may legitimately version: a hand-written Word
# reference document, in the directory documented as the escape hatch.
!.project/templates/export/reference.docx

# The report folders ship with a .gitkeep so they survive a fresh clone.
# Nothing above ignores them, so no negation pattern is needed here —
# if you ever add one (e.g. `.project/reports/*`), re-add the negations:
#   !.project/reports/technical/.gitkeep
#   !.project/reports/literary/.gitkeep
